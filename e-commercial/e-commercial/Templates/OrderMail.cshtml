@model e_commercial.DTOs.Response.Mail.OrderMailDTO

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đơn hàng của bạn tại ReagVN Shop</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7f7f7;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 20px auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
        }

        h2 {
            color: #333;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .total {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Xin chào @Model.UserName,</h2>

        <p>Cảm ơn bạn đã đặt hàng tại <strong>ReagVN Shop</strong>. Mã đơn hàng của bạn là <strong>@Model.OrderId</strong>.</p>

        <p>Chi tiết đơn hàng:</p>

        <table>
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ProductDetail)
                {
                    <tr>
                        <td>@(item.Item2.ToString() + " " + item.Item1)</td>
                        <td>@item.Item4</td>
                        <td>@item.Item3.ToString("C0")</td>
                        <td>@( (item.Item3 * item.Item4).ToString("C0") )</td> <!--C0 = Currency format-->
                    </tr>
                }
            </tbody> 
        </table>

        <p class="total">
            Tổng cộng: @Model.ProductDetail.Sum(x => x.Item3 * x.Item4).ToString("C0")
        </p>

        <p>Chúng tôi sẽ liên hệ với bạn sớm để xác nhận đơn hàng.</p>

        <p>Trân trọng,<br />ReagVN Shop</p>
    </div>
</body>
</html>